{
  "EventGuard": {
    "Provider": "PostgreSql",
    "Schema": "eventguard_worker",
    "Tenant": "development",
    "Consumer": "product-projection",
    "Source": "catalog",
    "MaximumConcurrency": 4,
    "LeaseSeconds": 30
  },
  "Logging": {"LogLevel": {"Default": "Warning", "Microsoft.Hosting.Lifetime": "Information"}}
}
