{
  "EventGuard": {
    "Provider": "PostgreSql",
    "Schema": "eventguard_worker",
    "Tenant": "development",
    "Consumer": "product-projection",
    "Source": "catalog",
    "MaximumConcurrency": 4,
    "LeaseSeconds": 30,
    "Processing": {
      "ShutdownTimeout": "00:00:30",
      "Defaults": { "Retry": { "MaximumAttempts": 5 } },
      "Workers": { "products": { "Enabled": true } }
    }
  },
  "Logging": {"LogLevel": {"Default": "Warning", "Microsoft.Hosting.Lifetime": "Information"}}
}
