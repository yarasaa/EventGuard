<configuration>
  <packageSources>
    <clear />
    <add key="eventguard-local" value="../../.artifacts/packages" />
    <add key="verified-dependency-cache" value="../../.tools/nuget-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="eventguard-local"><package pattern="EventGuard.*" /></packageSource>
    <packageSource key="verified-dependency-cache"><package pattern="*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
