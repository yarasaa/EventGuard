<Project>
  <!-- This application deliberately does not inherit the library build configuration. -->
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable><Version>1.0.0</Version>
  </PropertyGroup>
</Project>
