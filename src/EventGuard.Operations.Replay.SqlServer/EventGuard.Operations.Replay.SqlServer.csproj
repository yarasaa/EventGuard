<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Microsoft SQL Server replay and recovery commands for EventGuard. Persist idempotent replay requests, execute bulk recovery operations and manage quarantined work or outgoing message repair with audit records. Add to an authorized operations host. Experimental preview; not production ready.</Description>
    <PackageTags>$(PackageTags);sqlserver;mssql;sql-client;replay;recovery;idempotency;quarantine;outbox;audit;batch-processing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EventGuard.Operations/EventGuard.Operations.csproj" />
    <ProjectReference Include="../EventGuard.SqlServer/EventGuard.SqlServer.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
