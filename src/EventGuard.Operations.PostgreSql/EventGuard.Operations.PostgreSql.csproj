<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>PostgreSQL monitoring readers for EventGuard. Read bounded pages of work, outbox messages, backlog, ingress state and audit history for operations dashboards and support tools. Uses Npgsql independently of processing workers. Experimental preview; not production ready.</Description>
    <PackageTags>$(PackageTags);postgresql;postgres;npgsql;monitoring;observability;operations;outbox;backlog;audit;pagination</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EventGuard.Operations/EventGuard.Operations.csproj" />
    <PackageReference Include="Npgsql" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
