@page "/"
@model IndexModel
@inject DashboardOptions Settings
@inject DashboardReplays Replays
@{ ViewData["Title"] = "Work items"; }
<div class="page-heading"><div><div class="eyebrow">OPERATIONS OVERVIEW</div><h1>Work items</h1><p>Track event status and processing history.</p></div><a class="button" asp-page="/Index" asp-all-route-data="@(Model.Data is { } current ? FilterInput.Routes(current.Scope.Key, current.State, current.Filters) : null)"><span aria-hidden="true">↻</span> Refresh</a></div>
@if (Model.Unavailable)
{
    <section class="notice error" role="alert"><h2>Data is temporarily unavailable</h2><p>The read connection or query capacity is temporarily unavailable. This does not mean there are no records. Please try again.</p></section>
}
else if (Model.Data is { } data)
{
    <div class="context-row"><span class="context-label">SCOPE</span><strong>@data.Scope.Label</strong><span class="context-source">@data.Scope.Source / @data.Scope.EventType</span></div>
    @if (Settings.BulkReplayEnabled && Replays.CanReplay(User, data.Scope)) { <div class="replay-actions"><a class="button" asp-page="/BulkReplay" asp-route-kind="consumer" asp-route-scope="@data.Scope.Key">Prepare bulk replay</a></div> }
    <form method="get" class="filters">
        <div class="field"><label for="scope">Consumer</label><select name="scope" id="scope">@foreach (var scope in Model.Scopes) { <option value="@scope.Key" selected="@(scope.Key == data.Scope.Key)">@scope.Label</option> }</select></div>
        <div class="field"><label for="state">Status</label><select name="state" id="state"><option value="">All statuses</option>@foreach (var state in Enum.GetValues<WorkState>()) { <option value="@state" selected="@(state == data.State)">@Display.State(state)</option> }</select></div>
        <button class="button primary" type="submit">Apply filters</button>
        <a class="reset-filter" asp-page="/Index" asp-route-scope="@data.Scope.Key">Clear filters</a>
        <div class="read-time"><span class="small-dot"></span>Last read<strong>@Display.Time(data.Snapshot.ReadFinishedAt) UTC</strong></div>
        <details class="advanced-filters" open="@(data.Filters != new EventGuard.Operations.WorkFilters())">
            <summary>More filters</summary>
            <div class="filter-grid">
                <div class="field work-search"><label for="workId">Work ID (exact)</label><input type="text" id="workId" name="workId" value="@data.Filters.WorkId" maxlength="36" placeholder="Full work UUID" /></div>
                <div class="field"><label for="from">Created from · UTC (inclusive)</label><input type="datetime-local" id="from" name="from" value="@FilterInput.Time(data.Filters.CreatedFrom)" step="1" /></div>
                <div class="field"><label for="until">Created before · UTC (exclusive)</label><input type="datetime-local" id="until" name="until" value="@FilterInput.Time(data.Filters.CreatedUntil)" step="1" /></div>
                <div class="field"><label for="minimumAttempts">Minimum attempts</label><input type="number" id="minimumAttempts" name="minimumAttempts" value="@data.Filters.MinimumAttempts" min="0" max="2147483647" placeholder="Any" /></div>
                <div class="field"><label for="replayed">Replay history</label><select id="replayed" name="replayed"><option value="">Any</option><option value="yes" selected="@(data.Filters.Replayed == true)">Replayed</option><option value="no" selected="@(data.Filters.Replayed == false)">Never replayed</option></select></div>
            </div>
            <p class="filter-hint">Filters apply together within the selected consumer. Use Apply filters to update the results.</p>
        </details>
    </form>
    <section class="card">
        <div class="card-heading"><h2>Work records <span class="count">@data.Snapshot.Value.Items.Count</span></h2><span class="muted">This page · Newest first</span></div>
        @if (data.Snapshot.Value.Items.Count == 0)
        {
            <div class="empty"><div class="empty-icon">✓</div><h3>No records match these filters</h3><p>Change the consumer or status filter to view other work items.</p></div>
        }
        else
        {
            <div class="table-scroll"><table><thead><tr><th>Work ID</th><th>Status</th><th>Attempts</th><th>Created · UTC</th><th>History</th></tr></thead><tbody>
            @foreach (var work in data.Snapshot.Value.Items)
            {
                <tr><td><a class="work-id" asp-page="/Work" asp-route-scope="@data.Scope.Key" asp-route-id="@work.Id" asp-route-returnTo="@data.CurrentCursor">@work.Id.ToString("D")[..13]<span>…</span></a><small class="row-sub">Version @work.Version</small></td><td><span class="status @work.State"><span class="small-dot"></span>@Display.State(work.State)</span></td><td class="numeric">@work.AttemptCount <span class="muted">attempts</span></td><td>@Display.Time(work.CreatedAt)</td><td><a class="detail-link" asp-page="/Work" asp-route-scope="@data.Scope.Key" asp-route-id="@work.Id" asp-route-returnTo="@data.CurrentCursor">View details <span aria-hidden="true">↗</span></a></td></tr>
            }
            </tbody></table></div>
        }
        <div class="pagination"><span>Up to 25 records per page.</span><nav class="page-links" aria-label="Pagination"><a class="button" asp-page="/Index" asp-all-route-data="@FilterInput.Routes(data.Scope.Key, data.State, data.Filters)">First page</a>@if (data.PreviousCursor is not null) { <a class="button" rel="prev" asp-page="/Index" asp-all-route-data="@FilterInput.Routes(data.Scope.Key, data.State, data.Filters)" asp-route-cursor="@data.PreviousCursor">← Previous page</a> } else { <span class="button disabled" aria-disabled="true">← Previous page</span> }@if (data.NextCursor is not null) { <a class="button" asp-page="/Index" asp-all-route-data="@FilterInput.Routes(data.Scope.Key, data.State, data.Filters)" asp-route-cursor="@data.NextCursor">Next page →</a> } else { <span class="button disabled" aria-disabled="true">Next page →</span> }</nav></div>
    </section>
    <div class="footnote"><span aria-hidden="true">ⓘ</span><p>Statuses may change as work progresses. Pages reflect separate reads. Open a record to see its operation and any enabled event data.</p></div>
}
