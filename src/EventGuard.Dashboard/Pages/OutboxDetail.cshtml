@page "/outbox/{scope}/{id:guid}"
@model OutboxDetailModel
@inject DashboardRecovery Recovery
@{ ViewData["Title"] = "Outgoing event"; }
<a class="back" href="@Model.ReturnUrl">← Back to outgoing events</a>
<div class="page-heading"><div><div class="eyebrow">@Model.Scope.Label</div><h1>Outgoing event</h1><p>Publication status, attempt history and quarantine metadata.</p></div><span class="read-only">@(Model.CanReplay ? "Operator access" : "Read only")</span></div>
@if (Model.Unavailable)
{ <section class="notice error" role="alert"><h2>Data is temporarily unavailable</h2><p>This does not mean the intent is missing. Please reload the page.</p></section> }
else if (Model.Data?.Value is { } detail)
{
    var item = detail.Message;
    @if (Model.CanReplay) { <div class="replay-actions"><a class="button" asp-page="/OutboxReplay" asp-route-scope="@Model.Scope.Key" asp-route-id="@item.Id">Review replay eligibility</a></div> }
    <section class="card operation-card"><div class="card-heading"><h2>@(string.IsNullOrWhiteSpace(Model.Scope.Operation) ? Model.Scope.Label : Model.Scope.Operation)</h2><span class="muted">Intended publication</span></div>
        <p class="operation-copy">@(string.IsNullOrWhiteSpace(Model.Scope.Description) ? "The application has not provided a publication description." : Model.Scope.Description)</p>
        <dl class="facts"><div><dt>Producer</dt><dd>@Model.Scope.Producer</dd></div><div><dt>Transport</dt><dd>@item.Transport</dd></div><div><dt>Target binding</dt><dd>@item.Binding</dd></div><div><dt>Binding version</dt><dd>@item.BindingVersion</dd></div></dl>
        <p class="data-note">Bindings are application-defined logical names, shown up to 128 characters. Payload, headers, destination address and routing key are not displayed.</p>
    </section>
    <section class="card detail-card"><div class="card-heading"><code class="full-id">@item.Id</code><span class="status @item.State">@OutboxDisplay.State(item.State)</span></div>
        <p class="explanation">@OutboxDisplay.Explanation(item.State)</p>
        @if (item.DeliveryUncertain) { <div class="delivery-notice" role="status"><strong>Possible earlier delivery</strong><p>An earlier attempt may have reached its destination. A later success does not remove this uncertainty; another send could create a duplicate.</p></div> }
        <dl class="facts"><div><dt>Message ID</dt><dd>@item.MessageId</dd></div><div><dt>State version</dt><dd>@item.Version</dd></div><div><dt>Total attempts</dt><dd>@item.AttemptCount</dd></div><div><dt>Replay generation</dt><dd>@item.ReplayGeneration</dd></div><div><dt>Reason code</dt><dd>@(item.ReasonCode ?? "—")</dd></div><div><dt>Created · UTC</dt><dd>@Display.Time(item.CreatedAt)</dd></div><div><dt>Next attempt · UTC</dt><dd>@(item.State is OutboxState.Pending or OutboxState.RetryScheduled ? Display.Time(item.NextAttemptAt) : "—")</dd></div><div><dt>Published · UTC</dt><dd>@Display.Time(item.PublishedAt)</dd></div></dl>
    </section>
    @if (item.State == OutboxState.Quarantined || detail.Quarantine is not null)
    {
        <section class="card quarantine-card"><div class="card-heading"><h2>Quarantine</h2><span class="muted">Stored envelope validation</span></div>
        @if (detail.Quarantine is { } quarantine)
        { <dl class="facts"><div><dt>Quarantine ID</dt><dd>@quarantine.Id</dd></div><div><dt>Detected · UTC</dt><dd>@Display.Time(quarantine.DetectedAt)</dd></div><div><dt>Observed version</dt><dd>@quarantine.ObservedVersion</dd></div><div><dt>Validation reason</dt><dd>@(quarantine.ReasonCode ?? "—")</dd></div></dl> }
        else { <p class="explanation">The quarantine metadata was not available in this read. Reload or investigate the store.</p> }
        @if (item.State == OutboxState.Quarantined && Recovery.CanRecover(User, "outbox", Model.Scope.Key)) { <a class="button" asp-page="/Recovery" asp-route-kind="outbox" asp-route-scope="@Model.Scope.Key" asp-route-id="@item.Id">Review envelope repair</a> }
        <p class="data-note">The original snapshot stays in the database and is not loaded by this screen. Review the validation failure through an authorized operational process. Authorized recovery operators can restore the exact original envelope from a trusted backup.</p></section>
    }
    <section class="card history"><div class="card-heading"><h2>Publish attempts</h2><span class="muted">Latest 50 attempts</span></div>
        @if (detail.Attempts.Count == 0) { <div class="empty compact">No publish attempts have been recorded.</div> }
        else { <div class="table-scroll"><table><thead><tr><th>Attempt / generation</th><th>Result</th><th>Reason</th><th>Started · UTC</th><th>Finished · UTC</th></tr></thead><tbody>@foreach (var attempt in detail.Attempts) { <tr><td>#@attempt.Number / @attempt.Generation</td><td>@attempt.Status</td><td>@(attempt.ReasonCode ?? "—")</td><td>@Display.Time(attempt.StartedAt)</td><td>@Display.Time(attempt.FinishedAt)</td></tr> }</tbody></table></div> }
        @if (detail.HasOlderAttempts) { <p class="truncated">Older attempts are not included in this view.</p> }
    </section>
    <section class="card history"><div class="card-heading"><h2>Replay history</h2><span class="muted">Latest 20 requests</span></div>
        @if (detail.Replays.Count == 0) { <div class="empty compact">No persisted replay requests.</div> }
        else { <div class="table-scroll"><table><thead><tr><th>Request ID</th><th>Result</th><th>Generation / version</th><th>Duplicate risk acknowledged</th><th>Created · UTC</th></tr></thead><tbody>@foreach (var replay in detail.Replays) { <tr><td><code>@replay.RequestId</code></td><td>@replay.Status</td><td>@replay.Generation / @replay.Version</td><td>@(replay.AcknowledgePossibleDuplicate ? "Yes" : "No")</td><td>@Display.Time(replay.CreatedAt)</td></tr> }</tbody></table></div> }
        @if (detail.HasOlderReplays) { <p class="truncated">Older requests are not included in this view.</p> }
    </section>
    <div class="footnote"><span aria-hidden="true">ⓘ</span><p>Last read: @Display.Time(Model.Data.ReadFinishedAt) UTC. Status and history may reflect different instants. Only recognized library reason codes are displayed; application-defined codes appear as unrecognized.</p></div>
}
